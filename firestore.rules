rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null
        && (
          (
            request.auth.token.email is string
            && request.auth.token.email in [
              'stellarisairlines@gmail.com',
              'stellaris.web.dev@gmail.com'
            ]
          )
          ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          )
        );
    }

    function validDisplayName() {
      return request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 50;
    }

    function validOptionalPhotoURL() {
      return !('photoURL' in request.resource.data)
        || request.resource.data.photoURL is string;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list, delete: if false;

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'email',
          'displayName',
          'provider',
          'role',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'photoURL',
          'provider',
          'role',
          'status',
          'termsAccepted',
          'privacyAccepted',
          'termsVersion',
          'privacyVersion',
          'termsAcceptedAt',
          'privacyAcceptedAt',
          'createdAt',
          'updatedAt'
        ])
        && request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email
        && validDisplayName()
        && validOptionalPhotoURL()
        && request.resource.data.provider in ['password', 'google.com']
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'updatedAt'])
        && validDisplayName()
        && validOptionalPhotoURL()
        && request.resource.data.updatedAt == request.time;
    }

    match /bookings/{bookingId} {
      allow get, list: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'bookingRef',
          'userId',
          'email',
          'origin',
          'destination',
          'flightNumber',
          'segments',
          'passengers',
          'cabin',
          'totalFare',
          'currency',
          'milesEarned',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'bookingRef',
          'userId',
          'email',
          'origin',
          'destination',
          'flightNumber',
          'segments',
          'passengers',
          'cabin',
          'totalFare',
          'currency',
          'milesEarned',
          'status',
          'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.bookingRef is string
        && request.resource.data.bookingRef.size() == 8
        && request.resource.data.origin is string
        && request.resource.data.destination is string
        && request.resource.data.flightNumber is string
        && request.resource.data.segments is list
        && request.resource.data.segments.size() >= 1
        && request.resource.data.segments.size() <= 2
        && request.resource.data.passengers is int
        && request.resource.data.passengers >= 1
        && request.resource.data.passengers <= 9
        && request.resource.data.cabin in ['economy', 'premium']
        && request.resource.data.totalFare is int
        && request.resource.data.totalFare >= 0
        && request.resource.data.totalFare <= 100000000
        && request.resource.data.currency == 'KRW'
        && request.resource.data.milesEarned is int
        && request.resource.data.milesEarned >= 0
        && request.resource.data.milesEarned <= 500000
        && request.resource.data.status == 'ticketed'
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.status == 'ticketed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'passengerManifest',
          'passengerCount',
          'leadPassengerName',
          'contactEmail',
          'contactPhone',
          'passengerManifestUpdatedAt',
          'paymentStatus',
          'paymentMethod',
          'paymentMode',
          'paymentReference',
          'paymentUpdatedAt'
        ])
        && (!('passengerManifest' in request.resource.data)
          || (request.resource.data.passengerManifest is list
            && request.resource.data.passengerManifest.size() >= 1
            && request.resource.data.passengerManifest.size() <= 9))
        && (!('passengerCount' in request.resource.data)
          || (request.resource.data.passengerCount is int
            && request.resource.data.passengerCount >= 1
            && request.resource.data.passengerCount <= 9))
        && (!('leadPassengerName' in request.resource.data)
          || (request.resource.data.leadPassengerName is string
            && request.resource.data.leadPassengerName.size() <= 120))
        && (!('contactEmail' in request.resource.data)
          || (request.resource.data.contactEmail is string
            && request.resource.data.contactEmail.size() <= 254))
        && (!('contactPhone' in request.resource.data)
          || (request.resource.data.contactPhone is string
            && request.resource.data.contactPhone.size() <= 40))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['passengerManifestUpdatedAt'])
          || request.resource.data.passengerManifestUpdatedAt == request.time)
        && (!('paymentStatus' in request.resource.data)
          || request.resource.data.paymentStatus == 'paid-demo')
        && (!('paymentMethod' in request.resource.data)
          || request.resource.data.paymentMethod in ['demo-card', 'demo-bank', 'demo-wallet'])
        && (!('paymentMode' in request.resource.data)
          || request.resource.data.paymentMode == 'simulation')
        && (!('paymentReference' in request.resource.data)
          || (request.resource.data.paymentReference is string
            && request.resource.data.paymentReference.size() <= 40))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentUpdatedAt'])
          || request.resource.data.paymentUpdatedAt == request.time);

      allow delete: if false;
    }

    match /bookingPassengerDrafts/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll(['userId', 'passengers', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['userId', 'passengers', 'updatedAt', 'clearedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.passengers is list
        && request.resource.data.passengers.size() <= 9
        && request.resource.data.updatedAt == request.time
        && (!('clearedAt' in request.resource.data) || request.resource.data.clearedAt == request.time);
      allow delete: if isOwner(userId);
    }

    match /siteContent/homeBanner {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['active', 'text', 'linkLabel', 'linkUrl', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['active', 'text', 'linkLabel', 'linkUrl', 'updatedAt'])
        && request.resource.data.active is bool
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 180
        && request.resource.data.linkLabel is string
        && request.resource.data.linkLabel.size() <= 40
        && request.resource.data.linkUrl is string
        && request.resource.data.linkUrl.size() <= 220
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['category', 'title', 'body', 'pinned', 'publishedAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['category', 'title', 'body', 'pinned', 'publishedAt', 'updatedAt'])
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 30
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 5000
        && request.resource.data.pinned is bool
        && request.resource.data.publishedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['category', 'title', 'body', 'pinned', 'publishedAt', 'updatedAt'])
        && request.resource.data.publishedAt == resource.data.publishedAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 30
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 5000
        && request.resource.data.pinned is bool;
      allow delete: if isAdmin();
    }

    match /flightInventories/{flightKey}/seats/{seatId} {
      function validSeatRecord() {
        return request.resource.data.keys().hasAll([
            'flightKey',
            'flightNumber',
            'date',
            'origin',
            'destination',
            'aircraft',
            'cabin',
            'seatId',
            'status',
            'ownerId',
            'holdExpiresAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'flightKey',
            'flightNumber',
            'date',
            'origin',
            'destination',
            'aircraft',
            'cabin',
            'seatId',
            'status',
            'ownerId',
            'holdExpiresAt',
            'bookingId',
            'bookingRef',
            'updatedAt'
          ])
          && request.resource.data.flightKey == flightKey
          && request.resource.data.seatId == seatId
          && request.resource.data.flightNumber is string
          && request.resource.data.date is string
          && request.resource.data.origin is string
          && request.resource.data.destination is string
          && request.resource.data.aircraft is string
          && request.resource.data.cabin in ['economy', 'business', 'first']
          && request.resource.data.ownerId is string
          && request.resource.data.holdExpiresAt is timestamp
          && request.resource.data.updatedAt == request.time;
      }

      function validHold() {
        return request.resource.data.status == 'held'
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.holdExpiresAt > request.time
          && request.resource.data.holdExpiresAt <= request.time + duration.value(20, 'm')
          && !request.resource.data.keys().hasAny(['bookingId', 'bookingRef']);
      }

      function validTicket() {
        return request.resource.data.status == 'ticketed'
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.bookingId is string
          && request.resource.data.bookingRef is string
          && existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
          && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.bookingRef == request.resource.data.bookingRef;
      }

      allow get, list: if request.auth != null;

      allow create: if request.auth != null
        && validSeatRecord()
        && validHold();

      allow update: if request.auth != null
        && validSeatRecord()
        && request.resource.data.flightKey == resource.data.flightKey
        && request.resource.data.flightNumber == resource.data.flightNumber
        && request.resource.data.date == resource.data.date
        && request.resource.data.origin == resource.data.origin
        && request.resource.data.destination == resource.data.destination
        && request.resource.data.aircraft == resource.data.aircraft
        && request.resource.data.cabin == resource.data.cabin
        && request.resource.data.seatId == resource.data.seatId
        && resource.data.status == 'held'
        && (
          (
            resource.data.ownerId == request.auth.uid
            && resource.data.holdExpiresAt > request.time
            && (validHold() || validTicket())
          )
          ||
          (
            resource.data.holdExpiresAt <= request.time
            && validHold()
          )
        );

      allow delete: if request.auth != null
        && resource.data.status == 'held'
        && resource.data.ownerId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
